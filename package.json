{
  "name": "@local/good-at-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI 通关 — 用「AI 通关」把「怎么用 AI 干活」变成可判分的练习关卡（宿主 + 浏览器半区，零依赖）。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {},
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "check:levels": "node scripts/check-levels.mjs"
  }
}
